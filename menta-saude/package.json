{
  "name": "menta-saude",
  "version": "1.0.0",
  "description": "Sistema interno da Clínica Menta Saúde",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "delay": 1000,
    "ignore": [
      "server/data/",
      "client/",
      "*.db",
      "*.db-lock",
      "*.db.lock",
      "menta.db*",
      "server/menta.db*"
    ]
  }
}
